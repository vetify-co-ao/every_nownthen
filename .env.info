# Environment Variables Information
# This file documents all environment variables used by scripts in this project.
# DO NOT put actual values here - this file is committed to version control.
# Create a .env file locally with actual values (see .env.example).

# =============================================================================
# Example Script Variables (say_hello)
# =============================================================================

GREETING_NAME
  Description: Name to include in the greeting message
  Required: No
  Default: "World"
  Example: "John Doe"
  Used by: scripts/say_hello

GREETING_LANGUAGE
  Description: Language code for the greeting
  Required: No
  Default: "en"
  Example: "pt" (Portuguese), "es" (Spanish), "fr" (French), "de" (German)
  Allowed values: en, pt, es, fr, de
  Used by: scripts/say_hello

# =============================================================================
# iXLSX (scripts/ixlsx) — VCRM/VPIM/VSCO/Dashy/Vendus → bulletin + XLSX → Gmail
# =============================================================================

VENDUS_API_KEY
  Description: Vendus REST API key used for live stock
  Required: Yes
  Used by: scripts/ixlsx (also other Vendus-based tools)

VCRM_API_KEY
  Description: Read-only Antbox API key for recipients, announcements, and templates
  Required: Yes
  Used by: scripts/ixlsx
  Notes: Must allow node search, localized article reads, and export of nodes
         DJBTl5Ls (XLSX) and G64RDgSJ (HTML). There is no local fallback.

VPIM_API_KEY
  Description: Read-only Antbox API key for products, taxonomy, prices, VAT, and highlights
  Required: Yes
  Used by: scripts/ixlsx

VSCO_API_KEY
  Description: Read-only Antbox API key for import processes and cargo documents
  Required: No
  Used by: scripts/ixlsx
  Notes: When absent or unavailable, cargo sections are omitted and the degradation
         is written to the JSON run report.

SERVICE_ACCOUNT_KEY_PATH
  Description: Path to the Google service-account JSON key inside the container
  Required: Yes
  Example: "/etc/service_account.json"
  Used by: scripts/ixlsx, scripts/rc_reports (shared with Google-API scripts)
  Notes: Domain-wide delegation must allow gmail.send for iXLSX. iXLSX and
         RC reports impersonate comercial@vetify.co.ao.

iXLSX fixed email settings (not environment variables)
  IMPERSONATED_EMAIL: "comercial@vetify.co.ao"
  EMAIL_FROM: "Vetify <comercial@vetify.co.ao>"
  REPLY_TO: "encomendas@vetify.co.ao"
  EMAIL_SUBJECT: "Boletim Bissemanal Vetify · N.º <número> · <data>"

IXLSX_OUTPUT_DIR
  Description: Directory for generated HTML, XLSX, EML dry-run, and JSON report files
  Required: No
  Default: "/tmp"
  Used by: scripts/ixlsx

IXLSX_TEST_EMAILS
  Description: Comma-separated recipient list used only when invoked as
               `uv run ixlsx.py test all_e2e`
  Required: No
  Example: "qa@example.com,me@example.com"
  Used by: scripts/ixlsx

# =============================================================================
# RC Reports (scripts/rc_reports) — Dashy → XLSX → Gmail Royal Canin reports
# =============================================================================

DASHY_API_KEY
  Description: Dashy API key used to read dimensions, datasets, and metrics
  Required: Yes for RC reports; optional enrichment for iXLSX
  Used by: scripts/ixlsx, scripts/rc_reports
  Notes: Do not commit the real key. The scripts authenticate against Dashy and
         then use the temporary Dashy session cookie for dataset/metric calls.
         iXLSX loads the lot dataset once and uses the nearest future lot with
         positive remaining quantity. Failure leaves expiries blank and is reported.

RC_REPORTS_EMAIL_TO
  Description: Recipient email address for the Royal Canin report. Multiple
               recipients may be comma-separated.
  Required: Yes
  Example: "reports@example.com"
  Used by: scripts/rc_reports

RC_REPORTS_PERIOD_START_MONTH_DAY
  Description: Month and day for the first day of period 1. The year is always
               the current runtime year; each report period is 28 days long.
  Required: No
  Default: "01-01"
  Example: "01-01"
  Format: MM-DD
  Used by: scripts/rc_reports
  Notes: Auto mode runs P1 30 days after this date, then every 28 days through
         P12. P13 is sent on 12-30 every year.

RC_REPORTS_OUTPUT_DIR
  Description: Directory where generated RC_Report_PNN_YYYY-MM-DD_YYYY-MM-DD.xlsx files are written
  Required: No
  Default: "/tmp"
  Used by: scripts/rc_reports

RC reports fixed email settings (not environment variables)
  IMPERSONATED_EMAIL: "comercial@vetify.co.ao"
  EMAIL_FROM: "Vetify <comercial@vetify.co.ao>"
  REPLY_TO: "encomendas@vetify.co.ao"
  EMAIL_SUBJECT_TEMPLATE: "Royal Canin Report P%s (%s a %s)"

TZ
  Description: Container timezone (also aligns cron firing times)
  Required: No
  Default: container default (UTC)
  Example: "Africa/Luanda"
  Used by: All scripts

