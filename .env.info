# =============================================================================
# Common Variable Examples (Uncomment and customize as needed)
# =============================================================================

# API_KEY
#   Description: API key for external service
#   Required: Yes
#   Example: "sk-1234567890abcdef"
#   Format: String, alphanumeric
#   Used by: scripts/api_client
#   Notes: Get this from https://example.com/api-keys

# DATABASE_URL
#   Description: PostgreSQL database connection string
#   Required: Yes
#   Example: "postgresql://user:password@localhost:5432/dbname"
#   Format: PostgreSQL connection string
#   Used by: scripts/db_sync
#   Notes: Must have read/write permissions

# SMTP_HOST
#   Description: SMTP server hostname for sending emails
#   Required: Yes (if using email scripts)
#   Example: "smtp.gmail.com"
#   Used by: scripts/send_email

# SMTP_PORT
#   Description: SMTP server port
#   Required: Yes (if using email scripts)
#   Default: 587
#   Example: "587"
#   Used by: scripts/send_email

# SMTP_USER
#   Description: SMTP authentication username
#   Required: Yes (if using email scripts)
#   Example: "user@gmail.com"
#   Used by: scripts/send_email

# SMTP_PASSWORD
#   Description: SMTP authentication password
#   Required: Yes (if using email scripts)
#   Example: "app-specific-password"
#   Used by: scripts/send_email
#   Notes: Use app-specific passwords for Gmail

# AWS_ACCESS_KEY_ID
#   Description: AWS access key for S3/AWS services
#   Required: Yes (if using AWS scripts)
#   Example: "AKIAIOSFODNN7EXAMPLE"
#   Used by: scripts/s3_backup

# AWS_SECRET_ACCESS_KEY
#   Description: AWS secret key for S3/AWS services
#   Required: Yes (if using AWS scripts)
#   Example: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
#   Used by: scripts/s3_backup
#   Notes: Keep this secret, never commit

# AWS_REGION
#   Description: AWS region for services
#   Required: No
#   Default: "us-east-1"
#   Example: "eu-west-1"
#   Used by: scripts/s3_backup

# COMPANY_NAME
#   Description: Company name for documents and reports
#   Required: No
#   Example: "Acme Corporation"
#   Used by: scripts/generate_reports

# COMPANY_FISCAL_ID
#   Description: Company tax identification number
#   Required: Yes (for tax/invoice scripts)
#   Example: "123456789"
#   Used by: scripts/process_invoices

# DEBUG
#   Description: Enable debug mode for verbose logging
#   Required: No
#   Default: "false"
#   Example: "true"
#   Allowed values: true, false
#   Used by: All scripts

# LOG_LEVEL
#   Description: Logging level
#   Required: No
#   Default: "INFO"
#   Example: "DEBUG"
#   Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
#   Used by: All scripts

# TZ
#   Description: Timezone for timestamps
#   Required: No
#   Default: "UTC"
#   Example: "America/New_York", "Europe/Lisbon"
#   Used by: All scripts (via system)
